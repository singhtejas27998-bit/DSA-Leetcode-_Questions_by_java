import java.util.*;

class Solution {

    int[][] dp;

    public int stoneGameV(int[] stoneValue) {
        int n = stoneValue.length;

        int[] cumSum = new int[n];
        cumSum[0] = stoneValue[0];

        for (int i = 1; i < n; i++) {
            cumSum[i] = cumSum[i - 1] + stoneValue[i];
        }

        dp = new int[n][n];

        for (int i = 0; i < n; i++) {
            Arrays.fill(dp[i], -1);
        }

        return solve(0, n - 1, cumSum);
    }

    public int solve(int l, int r, int[] cumSum) {

        if (l >= r) {
            return 0;
        }

        if (dp[l][r] != -1) {
            return dp[l][r];
        }

        int score = 0;

        for (int mid = l; mid < r; mid++) {

            int leftSum;

            if (l - 1 >= 0) {
                leftSum = cumSum[mid] - cumSum[l - 1];
            } else {
                leftSum = cumSum[mid];
            }

            int rightSum = cumSum[r] - cumSum[mid];

            if (leftSum < rightSum) {

                score = Math.max(
                    score,
                    leftSum + solve(l, mid, cumSum)
                );

            } else if (leftSum > rightSum) {

                score = Math.max(
                    score,
                    rightSum + solve(mid + 1, r, cumSum)
                );

            } else {

                int leftScore =
                    leftSum + solve(l, mid, cumSum);

                int rightScore =
                    rightSum + solve(mid + 1, r, cumSum);

                score = Math.max(
                    score,
                    Math.max(leftScore, rightScore)
                );
            }
        }

        dp[l][r] = score;

        return score;
    }
}
