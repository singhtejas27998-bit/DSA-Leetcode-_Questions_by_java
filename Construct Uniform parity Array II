class Solution {
    public boolean uniformArray(int[] nums1) {
        int[] nums2 = new int[nums1.length];

        int min = nums1[0];

        for (int i = 1; i < nums1.length; i++) {
            if (nums1[i] < min) {
                min = nums1[i];
            }
        }

        for (int i = 0; i < nums1.length; i++) {
            if (nums1[i] % 2 == 0) {
                if (min % 2 == 1) {
                    nums2[i] = nums1[i] - min;
                } 
            } else {
                nums2[i] = nums1[i];
            }
        }

        for (int i = 1; i < nums2.length; i++) {
            if (nums2[i] % 2 != nums2[0] % 2) {
                return false;
            }
        }

        return true;
    }
}
