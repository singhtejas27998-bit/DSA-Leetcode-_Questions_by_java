import java.util.*;

class Solution {
    public int missingInteger(int[] nums) {
        HashSet<Integer> set = new HashSet<>();

        for (int num : nums) {
            set.add(num);
        }

        int sequential = nums[0];

        for (int i = 1; i < nums.length; i++) {
            if (nums[i] == nums[i - 1] + 1) {
                sequential += nums[i];
            } else {
                break;
            }
        }

        while (set.contains(sequential)) {
            sequential++;
        }

        return sequential;
    }
}
